# ==========================================
# Root Dependencies & Build Artifacts
# ==========================================
# Ignores node_modules in root, backend, or frontend
**/node_modules/

# Ignores frontend production build outputs
**/dist/
**/build/
**/out/

# ==========================================
# Environment Variables & Secrets (CRUCIAL)
# ==========================================
# Catches .env files anywhere in the workspace
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# ==========================================
# Logs & Diagnostics
# ==========================================
**/logs/
*.log
**/npm-debug.log*
**/yarn-debug.log*
**/pnpm-debug.log*

# ==========================================
# OS & IDE System Files (Global Junk)
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/